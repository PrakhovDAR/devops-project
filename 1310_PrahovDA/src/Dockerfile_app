# syntax=docker/dockerfile:1
# Minimum Docker version: 19.03.13
FROM ubuntu:22.04

LABEL maintainer="devops-project"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# ── System dependencies (single layer, pinned versions) ───────────────────
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        openssh-server \
        git \
        patch \
        ca-certificates && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    mkdir -p /var/run/sshd /root/.ssh && \
    chmod 700 /root/.ssh && \
    sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin prohibit-password/' /etc/ssh/sshd_config && \
    sed -i 's/#PubkeyAuthentication yes/PubkeyAuthentication yes/' /etc/ssh/sshd_config && \
    echo "AuthorizedKeysFile .ssh/authorized_keys" >> /etc/ssh/sshd_config && \
    ssh-keygen -A

WORKDIR /app

# ── Clone EXAMPLE_APP and apply patch to fix blocking issues ──────────────
RUN git clone --depth=1 https://github.com/moevm/devops-examples.git /tmp/devops-examples && \
    cp -r /tmp/devops-examples/EXAMPLE_APP/. /app/ && \
    rm -rf /tmp/devops-examples

COPY app/app.patch /tmp/app.patch

# Apply patch (p0: paths are relative to /app), then verify the app imports cleanly
RUN patch -p0 -d /app < /tmp/app.patch && \
    rm /tmp/app.patch 

# ── Python dependencies ───────────────────────────────────────────────────
COPY requirements_app.txt /tmp/requirements_app.txt
RUN pip3 install --no-cache-dir -r /tmp/requirements_app.txt && \
    rm /tmp/requirements_app.txt && \
    mkdir -p /app/FILES

# ── Entrypoint script ─────────────────────────────────────────────────────
COPY scripts/start_app.sh /usr/local/bin/start_app.sh
RUN sed -i 's/\r//' /usr/local/bin/start_app.sh && \
    chmod +x /usr/local/bin/start_app.sh

CMD ["/usr/local/bin/start_app.sh"]
