# ===========================================================================
# Public SSH key for container access.
# Generate a DEDICATED key pair (NOT your host key):
#   ssh-keygen -t ed25519 -f ~/.ssh/devops_project_key -N ""
# Then paste the content of ~/.ssh/devops_project_key.pub below:
# ===========================================================================
SSH_PUBLIC_KEY=ssh-ed25519 AAAA...your_public_key_here...== user@host

# SSH port on localhost for the app container   (must be > 1024)
SSH_PORT_APP=2222

# SSH port on localhost for the tester container (must be > 1024)
SSH_PORT_TESTER=2223

# Flask app port on localhost
APP_PORT=5000

# Internal hostname of the app service (docker-compose service name)
APP_HOST=app

# Internal port Flask listens on inside the app container
APP_INTERNAL_PORT=5000
