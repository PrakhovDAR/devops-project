FROM ubuntu:22.04

ARG DEBIAN_FRONTEND=noninteractive

WORKDIR /opt

RUN apt-get update && apt-get install -y --no-install-recommends \
	ca-certificates=20240203~22.04.1 \
	git=1:2.34.1-1ubuntu1.17 \
	patch=2.7.6-7build2 \
	python3=3.10.6-1~22.04.1 \
	python3-pip=22.0.2+dfsg-1ubuntu0.7 \
	&& rm -rf /var/lib/apt/lists/*

COPY app/app_patch.diff /opt/app_patch.diff

RUN git clone --depth 1 https://github.com/moevm/devops-examples.git /tmp/devops-examples && \
	cd /tmp/devops-examples && \
	patch -p1 < /opt/app_patch.diff && \
	mkdir -p /app && \
	cp -r EXAMPLE_APP/. /app/ && \
	rm -rf /tmp/devops-examples /opt/app_patch.diff

RUN pip3 install --no-cache-dir \
	Flask==2.3.3 \
	Werkzeug==2.3.8

WORKDIR /app

CMD ["python3", "main.py"]