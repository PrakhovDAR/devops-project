# Ubuntu 22.04 по требованию
FROM ubuntu:22.04

#Обновления 
RUN apt-get update && apt-get install -y \
        git=1:2.34.1-1ubuntu1.18 \
        python3=3.10.6-1~22.04.1 \
        python3-pip=22.0.2+dfsg-1ubuntu0.7 \
        patch=2.7.6-7build2 \
        openssh-server=1:8.9p1-3ubuntu0.18 && \
# Удалить скачанные файлы после обновления для экономии места
    rm -rf /var/lib/apt/lists/* && \
#Настраиваем SSH
    mkdir -p /var/run/sshd && \
    echo "PermitRootLogin prohibit-password" >> /etc/ssh/sshd_config && \
    echo "PasswordAuthentication no" >> /etc/ssh/sshd_config && \
    echo "PubkeyAuthentication yes" >> /etc/ssh/sshd_config && \
    ssh-keygen -A && \
# Загружаем приложение из репозитория
    git clone https://github.com/moevm/devops-examples.git && \
    mv /devops-examples/EXAMPLE_APP /app && \
    rm -rf /devops-examples

WORKDIR /tester

COPY . .
RUN mkdir -p /root/.ssh && \
    cat /tester/tester_rsa.pub >> /root/.ssh/authorized_keys && \
    chmod 700 /root/.ssh && \
    chmod 600 /root/.ssh/authorized_keys && \
    pip install -r requirements.txt && \
    chmod +x entrypoint.sh && \
    rm /tester/tester_rsa.pub
ENTRYPOINT ["/tester/entrypoint.sh"]